      background-color: var(--bg-dark);\
      color: var(--text-main);\
      line-height: 1.6;\
      scroll-behavior: smooth;\
    \}\
\
    /* Navigation */\
    header \{\
      position: sticky; top: 0; z-index: 100;\
      background: rgba(7, 17, 26, 0.92);\
