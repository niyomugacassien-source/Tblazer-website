      border-bottom: 1px solid var(--border);\
      padding: 16px 6%;\
      display: flex; justify-content: space-between; align-items: center;\
    \}\
    .brand \{ display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--text-main); \}\
    .brand-icon \{\
